<Application
    x:Class="LumaLink.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LumaGlassBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="LumaGlassStrokeBrush" Color="#A6FFFFFF" />
                    <SolidColorBrush x:Key="LumaInnerGlassBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="LumaPinBrush" Color="#14005FB8" />
                    <SolidColorBrush x:Key="LumaCardBrush" Color="#B3FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LumaGlassBrush" Color="#66141414" />
                    <SolidColorBrush x:Key="LumaGlassStrokeBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="LumaInnerGlassBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="LumaPinBrush" Color="#26005FB8" />
                    <SolidColorBrush x:Key="LumaCardBrush" Color="#99202020" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LumaCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource LumaGlassStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,16" />
            </Style>

            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
